# Go 项目统一 LF，避免 Windows 下 git add 出现 CRLF 警告
* text=auto eol=lf

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.proto text eol=lf

# 二进制不参与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
